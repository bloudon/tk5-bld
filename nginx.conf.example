# Nginx site config for bldpermit.com.
# Replace /path/to/tk5-bld and certificate paths for the target VPS.

server {
    listen 80;
    listen [::]:80;
    server_name bldpermit.com www.bldpermit.com expeditepermit.com www.expeditepermit.com;
    return 301 https://bldpermit.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.bldpermit.com expeditepermit.com www.expeditepermit.com;
    ssl_certificate /etc/letsencrypt/live/bldpermit.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bldpermit.com/privkey.pem;
    return 301 https://bldpermit.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name bldpermit.com;
    ssl_certificate /etc/letsencrypt/live/bldpermit.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bldpermit.com/privkey.pem;

    root /path/to/tk5-bld/artifacts/k5-website/dist/public;
    index index.html;

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass         http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location = /api {
        proxy_pass         http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location = / {
        try_files /index.html =404;
    }

    location ~ ^/(about|services|pricing|blog|contact|privacy|terms|blog/(?:admin|florida-permit-submittal-checklist|responding-to-florida-permit-review-comments|florida-notice-of-commencement-permitting))/$ {
        return 301 $scheme://$host/$1$is_args$args;
    }

    location ~ ^/(about|services|pricing|blog|contact|privacy|terms|blog/(?:admin|florida-permit-submittal-checklist|responding-to-florida-permit-review-comments|florida-notice-of-commencement-permitting))$ {
        try_files $uri/index.html =404;
    }

    location / {
        try_files $uri $uri/ =404;
        error_page 404 /404.html;
    }

    location = /404.html {
        internal;
    }
}
